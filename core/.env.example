APP_NAME="E-Commerce Platform"
APP_ENV=production
APP_KEY=base64:generate_using_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Database - Use external MySQL or PostgreSQL for production
DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true

# Cache & Session (optimized for serverless)
CACHE_DRIVER=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# File Storage - Use S3 for production
FILESYSTEM_DISK=local
# For production, use S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket
# AWS_URL=https://your-bucket.s3.amazonaws.com
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SCHEME=null

# Redis (optional, for cache/sessions)
# REDIS_CLIENT=predis
# REDIS_HOST=your-redis-host
# REDIS_PASSWORD=your-redis-password
# REDIS_PORT=6379
# REDIS_DB=0

# Frontend
FRONTEND_URL=https://your-project.vercel.app

# Payment Gateways (configure as needed)
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Social Login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Other Services
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=
Tawk-chat=
